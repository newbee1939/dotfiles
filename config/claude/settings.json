{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(brew outdated)",
      "Bash(terraform plan *)",
      "Bash(terraform validate *)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(npm list *)",
      "Bash(npm view *)",
      "Bash(npm outdated *)",
      "Bash(go version)",
      "Bash(go list *)",
      "Bash(go env *)",
      "Bash(go doc *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); c=$(jq -r '.tool_input.command // empty' <<<\"$i\" | head -1 | awk '{print $1}'); [ -n \"$c\" ] || exit 0; f=\"${TMPDIR:-/tmp}/claude-lowlayer-$(jq -r .session_id <<<\"$i\")\"; grep -qxF -- \"$c\" \"$f\" 2>/dev/null && exit 0; echo \"$c\" >>\"$f\"; jq -n --arg c \"$c\" '{hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:(\"低レイヤー還元: `\"+$c+\"` はこのセッション初出。回答の最後に1行だけ、このコマンドがコンピュータの中で実際に何をしているかを平易に書くこと。専門用語を使うなら短い言い換えを添える。\")}}'"
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "language": "Japanese",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "remoteControlAtStartup": true,
  "voiceEnabled": true,
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
