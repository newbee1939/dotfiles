[alias]
  st = status
  co = checkout
  br = branch

[fetch]
  prune = true

# 構文を理解してマージするドライバ https://mergiraf.org/
# 解析できないファイルは通常の行ベースマージにフォールバックする
[core]
  attributesFile = ~/.gitattributes.global

[merge "mergiraf"]
  name = mergiraf
  driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[include]
  path = ~/.gitconfig.local
